# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=postgres://ra_user:ra_password@localhost:5432/ra_backend

# Redis / Cache (disabled for now)
# REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Monitoring
SENTRY_DSN=

# Rate limiting
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_SIGNUP=20/hour
THROTTLE_LOGIN=20/hour

# Superuser bootstrap (optional — set to auto-provision the first admin on startup)
# DJANGO_SUPERUSER_PHONE_NUMBER=+919876543210
# DJANGO_SUPERUSER_PIN=123456
# DJANGO_SUPERUSER_NAME=Temple Admin
